                  "$ref": "#/$defs/ScalarExpr"
                },
                {
                  "$ref": "#/$defs/ScalarExpr"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": ["sub"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "div": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/ScalarExpr"
                },
                {
                  "$ref": "#/$defs/ScalarExpr"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": ["div"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "pow": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/ScalarExpr"
                },
                {
                  "$ref": "#/$defs/ScalarExpr"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": ["pow"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/ScalarExpr"
              }
            }
          },
          "required": ["min"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "max": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/ScalarExpr"
              }
