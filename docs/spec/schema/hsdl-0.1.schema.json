        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "side": {
          "type": "string",
          "enum": ["left", "right"]
        },
        "region": {
          "type": "string",
          "enum": [
            "skull",
            "cervical",
            "thoracic",
            "lumbar",
            "sacral",
            "thorax",
            "shoulder_girdle",
            "arm",
            "forearm",
            "hand",
            "pelvis",
            "thigh",
            "leg",
            "foot"
          ]
        },
        "restTransform": {
          "$ref": "#/$defs/TransformExpr"
        },
        "frame": {
          "$ref": "#/$defs/FrameDef"
        },
        "dimensions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/ScalarExpr"
          }
        },
        "geometry": {
          "$ref": "#/$defs/GeometryRecipe"
        },
        "density": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "redistribution": {
          "type": "object",
          "properties": {
            "flexion": {
              "type": "number",
              "minimum": 0
            },
            "lateralBending": {
              "type": "number",
              "minimum": 0
            },
            "axialRotation": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "ext": {
          "$ref": "#/$defs/__schema10"
        }
      },
      "required": [
        "id",
        "ta",
        "displayName",
        "parent",
        "region",
        "restTransform",
        "dimensions",
        "geometry"
      ],
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "TransformExpr": {
      "type": "object",
      "properties": {
        "translation": {
          "$ref": "#/$defs/Vec3Expr"
        },
        "rotation": {
          "$ref": "#/$defs/Quat"
        }
      },
      "required": ["translation", "rotation"],
      "additionalProperties": false
    },
    "Vec3Expr": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/ScalarExpr"
        },
        "y": {
          "$ref": "#/$defs/ScalarExpr"
        },
        "z": {
          "$ref": "#/$defs/ScalarExpr"
        }
      },
      "required": ["x", "y", "z"],
      "additionalProperties": false
    },
    "ScalarExpr": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "param": {
              "type": "string",
              "enum": [
                "sex",
                "stature",
                "mass",
                "percentile",
                "biiliacBreadth",
                "biacromialBreadth",
                "crural",
                "brachial",
                "relativeLegLength",
                "asymmetry"
              ]
            }
          },
          "required": ["param"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "add": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/ScalarExpr"
              }
