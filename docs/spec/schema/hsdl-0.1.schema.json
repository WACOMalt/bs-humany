        "locator": {
          "type": "string",
          "minLength": 1
        },
        "provisional": {
          "type": "object",
          "properties": {
            "openQuestion": {
              "type": "string",
              "pattern": "^OQ-\\d{3,}$"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["openQuestion", "rationale"]
        }
      },
      "required": ["key"],
      "additionalProperties": false
    },
    "BoneDef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "ta": {
          "type": "string",
          "minLength": 1
