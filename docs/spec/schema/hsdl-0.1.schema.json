        {
          "type": "object",
          "properties": {
            "lerp": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/ScalarExpr"
                },
                {
                  "$ref": "#/$defs/ScalarExpr"
                },
                {
                  "$ref": "#/$defs/ScalarExpr"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": ["lerp"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "blend": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/ScalarExpr"
                },
                {
                  "$ref": "#/$defs/ScalarExpr"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": ["blend"],
          "additionalProperties": false
        }
      ]
    },
    "Quat": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/__schema0"
        },
        "y": {
          "$ref": "#/$defs/__schema1"
        },
        "z": {
          "$ref": "#/$defs/__schema2"
        },
        "w": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": ["x", "y", "z", "w"],
      "additionalProperties": false
    },
    "__schema0": {
      "type": "number"
    },
    "__schema1": {
      "type": "number"
    },
    "__schema2": {
      "type": "number"
    },
    "__schema3": {
      "type": "number"
    },
    "FrameDef": {
      "type": "object",
      "properties": {
        "origin": {
          "$ref": "#/$defs/Id"
