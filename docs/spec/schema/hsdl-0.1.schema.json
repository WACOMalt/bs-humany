{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bsums.xyz/bs-humany/schema/hsdl-0.1.json",
  "title": "HSDL 0.1",
  "description": "HumanSim Description Language: the canonical body model for bs-humany. Generated from the Zod schemas in @bs-humany/hsdl. Do not edit by hand -- regenerate with `pnpm --filter @bs-humany/hsdl generate:schema`.",
  "type": "object",
  "properties": {
    "hsdlVersion": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "meta": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          }
        },
        "convention": {
          "default": "world",
          "type": "string",
          "enum": ["world", "isb", "z_up"]
        }
      },
      "required": ["name", "sources"],
      "additionalProperties": false
    },
    "units": {
      "type": "object",
      "properties": {
        "length": {
          "type": "string",
          "const": "m"
        },
        "mass": {
          "type": "string",
          "const": "kg"
        },
        "angle": {
          "type": "string",
          "const": "rad"
        },
        "time": {
          "type": "string",
          "const": "s"
        },
        "force": {
          "type": "string",
          "const": "N"
        }
      },
      "required": ["length", "mass", "angle", "time", "force"],
      "additionalProperties": false
    },
    "bones": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/BoneDef"
      }
    },
    "landmarks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LandmarkDef"
      }
    },
    "joints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/JointDef"
      }
    },
    "segmentation": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/SegmentationDef"
      }
    },
    "collisionProxies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CollisionProxy"
      }
    },
    "contactRules": {
      "$ref": "#/$defs/ContactRuleDef"
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConstraintDef"
      }
    },
    "morphology": {
      "$ref": "#/$defs/MorphologySpec"
    },
    "attachmentSites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AttachmentSiteDef"
      }
    },
    "wrappingSurfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/Id"
          },
          "bone": {
            "$ref": "#/$defs/Id"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "transform": {
            "$ref": "#/$defs/Transform"
          },
          "shape": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "cylinder"
                  },
                  "radius": {
                    "$ref": "#/$defs/ScalarExpr"
                  },
                  "length": {
                    "$ref": "#/$defs/ScalarExpr"
                  }
                },
                "required": ["kind", "radius", "length"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "ellipsoid"
                  },
                  "radii": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "$ref": "#/$defs/ScalarExpr"
                      },
                      "y": {
                        "$ref": "#/$defs/ScalarExpr"
                      },
                      "z": {
                        "$ref": "#/$defs/ScalarExpr"
                      }
                    },
                    "required": ["x", "y", "z"],
                    "additionalProperties": false
                  }
                },
                "required": ["kind", "radii"],
                "additionalProperties": false
              }
            ]
          },
          "source": {
            "$ref": "#/$defs/Citation"
          },
          "ext": {
            "$ref": "#/$defs/__schema10"
          }
        },
        "required": ["id", "bone", "displayName", "transform", "shape"],
        "additionalProperties": false
      }
    },
    "ext": {
      "$ref": "#/$defs/__schema10"
    }
  },
  "required": [
    "hsdlVersion",
    "id",
    "meta",
    "units",
    "bones",
    "landmarks",
    "joints",
    "segmentation",
    "collisionProxies",
    "contactRules",
    "constraints",
    "morphology",
    "attachmentSites"
