# Cargo's build directory. `Cargo.lock` is committed, because this crate is an application and a
# reproducible build is the whole reason the binary exists.
/target/

# Permission schemas, written by `tauri-build` on every build from the plugins in `Cargo.toml`.
# Generated, machine-formatted, and derivable from what is committed; Tauri's own template
# ignores them for the same reason.
/gen/schemas/
