{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bs-humany-studio",
  "version": "0.0.0",
  "identifier": "bsums.xyz.bs-humany.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm -w run dev",
    "beforeBuildCommand": "pnpm -w run build:studio"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "bs-humany studio",
        "width": 1600,
        "height": 1000,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Science",
    "shortDescription": "An anatomical body simulator.",
    "longDescription": "The bs-humany studio: a compiled skeleton, a physics backend and a Hill-type muscle set, with the scenarios that drive them.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
