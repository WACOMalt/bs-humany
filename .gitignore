node_modules/
dist/
.turbo/
coverage/
*.tsbuildinfo
.DS_Store
.vite/
apps/*/dist/
tools/*/dist/
.venv/
dist-release/
# The VR viewer copied in as a Tauri sidecar by `pnpm desktop:sidecar`.
apps/studio/src-tauri/binaries/
# Legacy local scratch from before the move to the data directory: run files now live there
# (`pnpm train:where` prints it), and what was left here is old logs and local probe scripts. A
# measurement anything cites is tracked instead -- `pnpm measure:reflex-gains`,
# `pnpm measure:dataset-gap`, `tools/train/probes/`.
tools/train/runs/

# Obsolete local copies of the Align tab's reference meshes, from the manual sync step there used
# to be. The vite refMeshes plugin serves and ships them now, from the tracked originals under
# tools/validate-external/myo_sim, and passes over a copy left here; git should too.
apps/studio/public/refMeshes/

# The Align tab's saved proposals land in the working directory, because a browser download has
# no say in where it goes. They are decisions to review and move somewhere deliberate, not
# things to pick up by accident.
/bonePairing.json
/sourceCorrespondence.json
/pointOverrides.json

# Playwright's own output from `pnpm test:e2e`: the traces of failed tests and any reports. CI
# uploads the traces as an artifact; locally they are for opening with `playwright show-trace`.
test-results/
playwright-report/
blob-report/
