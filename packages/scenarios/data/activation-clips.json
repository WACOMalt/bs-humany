    {
      "id": "walk-normal",
      "displayName": "Level walking, self-selected speed",
      "timebase": "cyclePercent",
      "cycleSeconds": 1.05,
      "loop": true,
      "provenance": "literature-timing",
      "normalization": "mvc",
      "phaseReference": "0 percent is RIGHT initial contact. Right toe-off near 62 percent. Stance 0-62, swing 62-100. Left leg is the same pattern shifted 50 percent.",
      "sources": [
        "Perry & Burnfield (2010) phase charts for onset and offset windows.",
        "Agostini et al. (2010): normative onset and offset across roughly 28,000 strides.",
        "Strazza et al. (2017), 16,315 strides: medial hamstrings overlap vastus lateralis and rectus femoris from terminal swing, about 80-100 percent, into loading response at about 0-15 percent, in roughly 90 percent of strides. That overlap is reproduced here deliberately.",
        "Di Nardo et al. (2013): a single muscle shows large stride-to-stride variability in the number of activation intervals and in onset and offset. A deterministic track is an average, not a truth."
      ],
      "limitations": [
        "TIMING IS SOURCED. AMPLITUDES ARE ESTIMATES. Amplitude is not portable across normalization methods, so these are plausible values, not measured ones.",
        "Open loop. This will not walk on its own. It reproduces the activity pattern of walking, not the balance controller that makes walking stable.",
        "Timing does not scale linearly with speed. Swing duration is far more stable than stance duration as speed changes, so simply changing cycleSeconds will be wrong beyond roughly plus or minus 20 percent of normal speed.",
        "Arm tracks are deliberately minimal. Arm swing in walking is largely passive, driven by trunk rotation. Consider leaving the arms undriven and letting the physics swing them.",
        "Left tracks are supplied as an exact 50 percent shift. Real gait is not perfectly symmetric; see research document section 6.2."
      ],
      "tracks": [
        {
          "target": { "kind": "group", "id": "hip_extensors" },
          "side": "right",
          "interpolation": "monotoneCubic",
          "note": "Hip extension from terminal swing through loading. Wraps past 100.",
          "points": [
            { "p": 0, "level": 0.24 },
            { "p": 8, "level": 0.25 },
            { "p": 15, "level": 0.12 },
            { "p": 22, "level": 0.02 },
            { "p": 88, "level": 0.02 },
            { "p": 94, "level": 0.16 },
            { "p": 100, "level": 0.24 }
          ]
        },
        {
          "target": { "kind": "group", "id": "hip_abductors" },
          "side": "right",
          "interpolation": "monotoneCubic",
          "note": "Single-limb support pelvic stabilization. Peaks early in stance.",
          "points": [
            { "p": 0, "level": 0.18 },
            { "p": 10, "level": 0.3 },
            { "p": 22, "level": 0.22 },
            { "p": 32, "level": 0.08 },
            { "p": 45, "level": 0.02 },
            { "p": 92, "level": 0.03 },
            { "p": 100, "level": 0.18 }
          ]
        },
        {
          "target": { "kind": "group", "id": "knee_flexors" },
          "side": "right",
          "interpolation": "monotoneCubic",
          "note": "Hamstrings. Decelerates the shank in terminal swing, then extends the hip through loading. Overlaps the vasti by design.",
          "points": [
            { "p": 0, "level": 0.22 },
            { "p": 8, "level": 0.18 },
            { "p": 15, "level": 0.07 },
            { "p": 25, "level": 0.02 },
            { "p": 78, "level": 0.02 },
            { "p": 86, "level": 0.2 },
            { "p": 94, "level": 0.25 },
            { "p": 100, "level": 0.22 }
          ]
        },
        {
          "target": { "kind": "group", "id": "knee_extensors" },
          "side": "right",
          "interpolation": "monotoneCubic",
          "note": "Vasti. Eccentric through loading response, absorbing knee flexion. Small pre-contact burst.",
          "points": [
