{
  "$schema": "./activation-clips.schema.json",
  "formatVersion": "0.1",
  "meta": {
    "document": "activation-clips",
    "companionTo": "humansim-activation-research v0.2",
    "boundTo": {
      "repository": "github.com/WACOMalt/bs-humany",
      "muscleDataPackage": "@bs-humany/muscle-data",
      "verifiedAgainst": "packages/muscle-data/src (ankle, knee, hip, torso, trunk, shoulder, elbow, forearm)",
      "channel": "efferent.alphaMotor",
      "field": "excitation",
      "note": "Every identifier below was checked against the exported muscle ids in packages/muscle-data. Identifiers absent from that package are listed under missingFromModel and are NOT referenced by any track."
    },
    "units": "Excitation u, dimensionless, 0 to 1. NOT activation a. The muscle module applies stepActivation(a, u, dt) with activationTime 0.01 s and deactivationTime 0.04 s, which supplies the electromechanical delay. Do not pre-shift these values.",
    "activationFloor": 0.001,
    "interpolationDefault": "monotoneCubic",
    "interpolationNote": "Clamp to [0,1]. Never use an unclamped spline: a negative excitation is physically meaningless."
  },

  "missingFromModel": {
    "note": "Muscles referenced by the source literature that have no counterpart in packages/muscle-data. Tracks that would need them are omitted, and the affected clips say so in their limitations array.",
    "scapulothoracic": [
      "trapezius_upper",
      "trapezius_middle",
      "trapezius_lower",
      "serratus_anterior",
      "rhomboid_major",
      "rhomboid_minor",
      "levator_scapulae"
    ],
    "consequence": "The shoulder girdle has a full rotator cuff (supraspinatus, infraspinatus, subscapularis, teres_minor) but nothing that positions the scapula on the thorax. The flail-arms clip therefore cannot brace the girdle as its design calls for. Expect the humerus to drive the scapula through the glenohumeral joint alone.",
    "recommendedTicket": "Add a scapulothoracic muscle set to muscle-data. Holzbaur et al. (2005) does not include them either; van der Helm (1994) shoulder model does."
  },

  "namingNotes": [
    "muscle-data exposes both lumped ids (gastrocnemius_r, deltoid_r, triceps_surae_r, quadriceps_femoris_r) and compartment ids (gastrocnemius_medial_r, deltoid_anterior_r). Every track below targets COMPARTMENT ids, per muscle spec M-ADR-005. Confirm whether the lumped ids are separate simulated units or parent bundles: if they are simulated units, driving both double-counts the force.",
    "The literature says 'peroneus longus'. muscle-data uses the current term 'fibularis_longus'. Same muscle.",
    "adductor_magnus is subdivided as proximal, middle, distal and ischiocondylar. Only the ischiocondylar compartment is a meaningful hip extensor; the others are adductors. The groups below reflect that."
  ],

  "groups": {
    "note": "Section 3.3 of the research document requires 27 weighted functional groups and none exist in the repository yet. These are the definitions. Weights are moment-arm-and-cross-section plausible, not measured. Every weight marked source 'even-split-pending-data' needs replacing with a real value.",

    "ankle_plantarflexors": {
      "source": "Weights approximate relative physiological cross-sectional area. Soleus dominates: it is monoarticular, large, and about 80 percent type I fibres.",
      "weights": {
        "soleus": 1.0,
        "gastrocnemius_medial": 0.6,
        "gastrocnemius_lateral": 0.35,
        "tibialis_posterior": 0.25,
        "fibularis_longus": 0.2,
        "fibularis_brevis": 0.12,
        "flexor_digitorum_longus": 0.1,
        "flexor_hallucis_longus": 0.12
      }
    },
    "ankle_dorsiflexors": {
      "source": "Tibialis anterior dominates by cross-section.",
      "weights": {
        "tibialis_anterior": 1.0,
        "extensor_digitorum_longus": 0.3,
        "extensor_hallucis_longus": 0.15
      }
    },
    "ankle_evertors": {
      "source": "even-split-pending-data",
      "weights": {
        "fibularis_longus": 1.0,
        "fibularis_brevis": 0.8,
        "extensor_digitorum_longus": 0.2
      }
    },
    "ankle_invertors": {
      "source": "even-split-pending-data",
      "weights": {
        "tibialis_posterior": 1.0,
        "tibialis_anterior": 0.5,
        "flexor_hallucis_longus": 0.25,
        "flexor_digitorum_longus": 0.2
      }
    },

    "knee_extensors": {
      "source": "Vasti carry the bulk. Rectus femoris is biarticular and is driven separately in gait, so it is weighted low here.",
      "weights": {
        "vastus_lateralis": 1.0,
        "vastus_medialis": 0.85,
        "vastus_intermedius": 0.6,
        "rectus_femoris": 0.4
      }
    },
    "knee_flexors": {
      "source": "Hamstrings dominate. Gastrocnemius contributes a small knee flexion moment.",
      "weights": {
        "biceps_femoris_long": 1.0,
        "semitendinosus": 0.7,
        "semimembranosus": 0.85,
        "biceps_femoris_short": 0.45,
        "gracilis": 0.2,
        "sartorius": 0.2,
        "gastrocnemius_medial": 0.25,
        "gastrocnemius_lateral": 0.15
      }
    },

    "hip_extensors": {
      "source": "Gluteus maximus compartments plus the hamstrings. Compartment weights follow the superior-to-inferior extension moment arm gradient.",
      "weights": {
        "gluteus_maximus_middle": 1.0,
        "gluteus_maximus_inferior": 0.9,
        "gluteus_maximus_superior": 0.7,
        "biceps_femoris_long": 0.6,
        "semimembranosus": 0.55,
        "semitendinosus": 0.5,
        "adductor_magnus_ischiocondylar": 0.4
      }
    },
    "hip_flexors": {
      "source": "Iliopsoas dominates. muscle-data exposes iliacus and psoas_major separately as well as a lumped iliopsoas; these target the separate compartments.",
      "weights": {
        "iliacus": 1.0,
        "psoas_major": 1.0,
        "rectus_femoris": 0.5,
        "tensor_fasciae_latae": 0.35,
        "sartorius": 0.25,
        "adductor_longus": 0.25,
        "adductor_brevis": 0.15
      }
    },
    "hip_abductors": {
      "source": "Gluteus medius is the primary frontal-plane stabilizer in single-limb support.",
      "weights": {
        "gluteus_medius_middle": 1.0,
        "gluteus_medius_anterior": 0.85,
        "gluteus_medius_posterior": 0.7,
        "gluteus_minimus_anterior": 0.4,
        "gluteus_minimus_middle": 0.4,
        "gluteus_minimus_posterior": 0.3,
        "tensor_fasciae_latae": 0.45,
        "gluteus_maximus_superior": 0.3
      }
    },
    "hip_adductors": {
      "source": "adductor_magnus compartments plus the short adductors. Note the ischiocondylar compartment is excluded: it acts as an extensor.",
      "weights": {
        "adductor_magnus_middle": 1.0,
        "adductor_magnus_proximal": 0.9,
        "adductor_magnus_distal": 0.85,
        "adductor_longus": 0.7,
        "adductor_brevis": 0.5,
        "gracilis": 0.3
      }
    },
    "hip_rotators_external": {
      "source": "even-split-pending-data. muscle-data has piriformis but not the obturators, gemelli or quadratus femoris.",
      "weights": {
        "piriformis": 1.0,
        "gluteus_maximus_superior": 0.5,
        "gluteus_medius_posterior": 0.3
      }
    },
    "hip_rotators_internal": {
      "source": "even-split-pending-data",
      "weights": {
        "gluteus_minimus_anterior": 1.0,
        "gluteus_medius_anterior": 0.8,
        "tensor_fasciae_latae": 0.5
      }
    },

    "trunk_extensors": {
      "source": "muscle-data exposes erector_spinae as one unit per side. No multifidus, no semispinalis, no quadratus lumborum.",
      "weights": { "erector_spinae": 1.0 }
    },
    "trunk_flexors": {
      "source": "even-split-pending-data",
      "weights": { "rectus_abdominis": 1.0, "external_oblique": 0.6, "internal_oblique": 0.6 }
    },
    "trunk_lateral_flexors": {
      "source": "even-split-pending-data. Driven unilaterally.",
      "weights": {
        "external_oblique": 1.0,
        "internal_oblique": 0.9,
        "erector_spinae": 0.6,
        "rectus_abdominis": 0.3
      }
    },

    "shoulder_flexors": {
      "source": "even-split-pending-data",
      "weights": {
        "deltoid_anterior": 1.0,
        "pectoralis_major_clavicular": 0.8,
        "coracobrachialis": 0.35,
        "biceps_brachii_long": 0.25,
        "biceps_brachii_short": 0.25
      }
    },
    "shoulder_extensors": {
      "source": "even-split-pending-data",
      "weights": {
        "deltoid_posterior": 1.0,
        "latissimus_dorsi_thoracic": 0.8,
        "latissimus_dorsi_lumbar": 0.6,
        "latissimus_dorsi_iliac": 0.5,
        "teres_major": 0.5,
        "triceps_brachii_long": 0.3
      }
    },
    "shoulder_abductors": {
      "source": "Supraspinatus initiates, deltoid_middle carries the range.",
      "weights": { "deltoid_middle": 1.0, "supraspinatus": 0.5, "deltoid_anterior": 0.4 }
    },
    "shoulder_rotators_external": {
      "source": "even-split-pending-data",
      "weights": { "infraspinatus": 1.0, "teres_minor": 0.6, "deltoid_posterior": 0.3 }
    },
    "shoulder_rotators_internal": {
      "source": "even-split-pending-data",
      "weights": {
        "subscapularis": 1.0,
        "pectoralis_major_sternal": 0.6,
        "teres_major": 0.5,
        "latissimus_dorsi_thoracic": 0.4
      }
    },
    "scapular_stabilizers": {
      "source": "EMPTY. See missingFromModel.scapulothoracic. This group is declared so clips can reference it and so the gap is visible, rather than silently omitted.",
      "weights": {}
    },

    "elbow_flexors": {
      "source": "Brachialis is the workhorse; biceps contributes more in supination.",
      "weights": {
        "brachialis": 1.0,
        "biceps_brachii_long": 0.8,
        "biceps_brachii_short": 0.8,
        "brachioradialis": 0.45
      }
    },
    "elbow_extensors": {
      "source": "even-split-pending-data",
      "weights": {
        "triceps_brachii_medial": 1.0,
        "triceps_brachii_lateral": 0.9,
        "triceps_brachii_long": 0.85,
        "anconeus": 0.15
      }
    },
    "forearm_pronators": {
      "source": "even-split-pending-data",
      "weights": { "pronator_teres": 1.0, "pronator_quadratus": 0.7 }
    },
    "forearm_supinators": {
      "source": "even-split-pending-data",
      "weights": { "supinator": 1.0, "biceps_brachii_long": 0.7, "biceps_brachii_short": 0.7 }
    },
    "wrist_flexors": {
      "source": "even-split-pending-data. No flexor digitorum or palmaris longus in muscle-data.",
      "weights": { "flexor_carpi_radialis": 1.0, "flexor_carpi_ulnaris": 0.9 }
    },
    "wrist_extensors": {
      "source": "even-split-pending-data. No extensor carpi ulnaris in muscle-data.",
      "weights": { "extensor_carpi_radialis_longus": 1.0, "extensor_carpi_radialis_brevis": 0.9 }
    }
  },

  "clips": [
    {
      "id": "quiet-standing",
      "displayName": "Quiet standing",
      "timebase": "seconds",
      "duration": 30.0,
      "loop": true,
      "provenance": "literature-timing",
      "normalization": "mvc",
      "sources": [
        "Body COM sits anterior to the ankle, so plantarflexors work continuously to resist forward rotation. Soleus and medial gastrocnemius are the two continuous contributors, under a common neural drive.",
        "Tibialis anterior is rarely active during quiet standing in healthy young adults.",
        "Co-contraction of plantarflexors and dorsiflexors raises ankle stiffness and INCREASES postural sway. Able-bodied subjects co-contract about 0.2 percent of the time; an incomplete-spinal-cord-injury group co-contracted about 75 percent of the time with eyes open, and swayed more.",
        "Sway-related modulation of ankle extensor activity occupies roughly 0.12 to 4 Hz.",
        "Sasagawa et al. (2009): extensor activity scales inversely with available passive contribution."
      ],
      "limitations": [
        "Open loop. This clip reproduces the muscle activity of quiet standing but cannot correct an error, because there is no feedback. Expect drift and eventual falling. Closing the loop is the nerve module's job.",
        "The amplitudes are a validation test as much as an animation. If the model needs soleus above about 0.15 to stand, something is wrong upstream: most likely maximum isometric force, the passive joint moments, or the mass distribution.",
        "No co-contraction by design. To model an unsteady or elderly stance, RAISE tibialis anterior to 0.05-0.10 and hold it continuously. That is the documented pathological pattern, so it is a feature."
      ],
      "tracks": [
        {
          "target": { "kind": "unit", "id": "soleus" },
          "side": "both",
          "interpolation": "monotoneCubic",
          "note": "Tonic. Carries the standing plantarflexor moment. Nearly flat.",
          "points": [
            { "t": 0.0, "level": 0.075 },
            { "t": 4.0, "level": 0.082 },
            { "t": 9.0, "level": 0.071 },
            { "t": 14.0, "level": 0.08 },
            { "t": 19.0, "level": 0.073 },
            { "t": 24.0, "level": 0.079 },
            { "t": 30.0, "level": 0.075 }
          ]
        },
        {
          "target": { "kind": "unit", "id": "gastrocnemius_medial" },
          "side": "right",
          "interpolation": "monotoneCubic",
          "note": "Sway-coupled modulation near 0.3 Hz. Damps the oscillation rather than holding position.",
          "points": [
            { "t": 0.0, "level": 0.02 },
            { "t": 1.7, "level": 0.058 },
            { "t": 3.3, "level": 0.021 },
            { "t": 5.0, "level": 0.055 },
            { "t": 6.7, "level": 0.024 },
            { "t": 8.3, "level": 0.06 },
            { "t": 10.0, "level": 0.022 },
            { "t": 11.7, "level": 0.052 },
            { "t": 13.3, "level": 0.026 },
            { "t": 15.0, "level": 0.057 },
            { "t": 16.7, "level": 0.02 },
            { "t": 18.3, "level": 0.054 },
            { "t": 20.0, "level": 0.025 },
            { "t": 21.7, "level": 0.059 },
            { "t": 23.3, "level": 0.022 },
            { "t": 25.0, "level": 0.053 },
            { "t": 26.7, "level": 0.027 },
            { "t": 28.3, "level": 0.056 },
            { "t": 30.0, "level": 0.02 }
          ]
        },
        {
          "target": { "kind": "unit", "id": "gastrocnemius_medial" },
          "side": "left",
          "interpolation": "monotoneCubic",
          "note": "Same pattern, deliberately phase-offset by about 0.6 s. Perfectly symmetric sway looks mechanical.",
          "points": [
