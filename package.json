{
  "name": "bs-humany",
  "version": "0.2.0",
  "private": true,
  "description": "Modular, anatomically grounded simulation framework for the human body",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "audit:obligations": "node tools/cli/bin/audit-obligations.mjs",
    "bench": "node tools/cli/bin/bench.mjs",
    "build:studio": "pnpm --filter @bs-humany/studio build",
    "cite:lint": "node tools/cli/bin/cite-lint.mjs",
    "check:generated": "node tools/cli/bin/check-generated.mjs",
    "desktop:appimage": "pnpm desktop:sidecar && NO_STRIP=true pnpm --filter @bs-humany/studio tauri build --bundles appimage",
    "desktop:build": "pnpm desktop:sidecar && pnpm --filter @bs-humany/studio tauri build --no-bundle",
    "desktop:dev": "pnpm desktop:sidecar && pnpm --filter @bs-humany/studio tauri dev",
    "desktop:sidecar": "node tools/cli/bin/desktop-sidecar.mjs",
    "desktop:tarball": "pnpm desktop:build && node tools/cli/bin/desktop-tarball.mjs",
    "dev": "pnpm --filter @bs-humany/studio dev",
    "extract:source-sites": "node tools/cli/bin/extract-source-sites.mjs",
    "generate:ankle-muscles": "node tools/cli/bin/generate-ankle-muscles.mjs",
    "generate:elbow-muscles": "node tools/cli/bin/generate-elbow-muscles.mjs",
    "generate:forearm-muscles": "node tools/cli/bin/generate-forearm-muscles.mjs",
    "generate:girdle-muscles": "node tools/cli/bin/generate-girdle-muscles.mjs",
    "generate:hand-muscles": "node tools/cli/bin/generate-hand-muscles.mjs",
    "generate:hip-muscles": "node tools/cli/bin/generate-hip-muscles.mjs",
    "generate:hsdl-schema": "node packages/hsdl/scripts/generate-schema.mjs",
    "generate:knee-muscles": "node tools/cli/bin/generate-knee-muscles.mjs",
    "generate:neck-muscles": "node tools/cli/bin/generate-neck-muscles.mjs",
    "generate:pose-bridge-fixture": "node tools/cli/bin/generate-pose-bridge-fixture.mjs",
    "generate:shoulder-muscles": "node tools/cli/bin/generate-shoulder-muscles.mjs",
    "generate:thorax-muscles": "node tools/cli/bin/generate-thorax-muscles.mjs",
    "generate:torso-muscles": "node tools/cli/bin/generate-torso-muscles.mjs",
    "generate:trunk-muscles": "node tools/cli/bin/generate-trunk-muscles.mjs",
    "generate:via-points": "node tools/cli/bin/generate-muscle-via-points.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "measure:muscle-ranges": "node tools/cli/bin/measure-muscle-ranges.mjs",
    "measure:source-travel": "node tools/cli/bin/measure-source-travel.mjs",
    "module:lint": "node tools/cli/bin/module-lint.mjs",
    "publish:pose": "node tools/cli/bin/publish-pose.mjs",
    "regenerate": "node tools/cli/bin/regenerate.mjs",
    "sync:ref-meshes": "mkdir -p apps/studio/public/refMeshes && cp tools/validate-external/myo_sim/meshes/*.stl apps/studio/public/refMeshes/",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "train:dashboard": "node tools/train/bin/dashboard.mjs",
    "train:nerves": "node tools/train/bin/train-nerves.mjs",
    "train:showcase": "node tools/train/bin/showcase.mjs",
    "train:where": "node tools/train/bin/where.mjs",
    "typecheck": "tsc --build --force && tsc -p apps/studio/e2e",
    "validate:external": "node tools/cli/bin/external-validate.mjs",
    "validate:moment-arms": "node tools/cli/bin/validate-moment-arms.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm cite:lint && pnpm module:lint && pnpm check:generated && pnpm test && pnpm build:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.5",
    "jiti": "^2.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
