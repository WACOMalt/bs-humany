tools/train/runs

# The Align tab's saved proposals, downloaded into the checkout root for somebody to review.
bonePairing.json
sourceCorrespondence.json
pointOverrides.json

# Stale local mesh copies: the vite refMeshes plugin ships the originals from tools/validate-external.
apps/studio/public/refMeshes
